rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile: role, streak state, buddy check-in flags.
    // The owning uid can read/write. A linked caregiver can also READ it
    // (streak status for their dashboard) - verified via the deterministic
    // links/{recoveringUid}_{caregiverUid} doc ID, no write access granted.
    match /users/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/links/$(uid + '_' + request.auth.uid)));
    }

    // The Gemini-generated emergency script. Only the owning uid may read/write.
    match /scripts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pairing codes: only the owning uid can create/delete their own code.
    // Any authenticated user can read (needed so a caregiver can look up a code).
    match /pairingCodes/{code} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Links between a recovering user and a caregiver.
    // Doc ID convention: {recoveringUid}_{caregiverUid}.
    // Only the caregiver can create the link (after looking up a valid pairing code).
    // Either party can read it.
    match /links/{linkId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.caregiverUid;
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.recoveringUid
            || request.auth.uid == resource.data.caregiverUid);
    }

    // Crisis/lapse alerts. Only the affected user can create their own alert,
    // with the caregiverIds list computed client-side from their own links.
    // Readable/acknowledgeable by the user themself or any listed caregiver.
    match /alerts/{alertId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.uid in resource.data.caregiverIds);
    }
  }
}
